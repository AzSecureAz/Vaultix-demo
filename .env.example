# Demo Service Environment Variables
PORT=8083

# Redis Configuration (Cache, Token Blacklist Check & Cross-Instance Pub/Sub)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=demo_user
SPRING_DATA_REDIS_PASSWORD=demo_password

# OAuth2 Resource Server & JWT Validation
VAULTIX_JWT_ISSUER=https://auth.vaultix.com
VAULTIX_JWT_JWK_SET_URI=http://localhost:8082/api/v1/auth/.well-known/jwks.json

# Eureka Service Discovery
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://localhost:8761/eureka/
